---
version: 1.5.1
title: json decoding
file: ./test/squirrel_test.gleam
test_name: json_decoding_test
---

import brioche/sql
import gleam/dynamic/decode
import gleam/javascript/promise

pub type QueryRow {
  QueryRow(res: String)
}

pub fn query(
  db: sql.Connection,
) -> promise.Promise(Result(sql.Returned(QueryRow), sql.SqlError)) {
  let decoder = {
    use res <- decode.field(0, json_decoder())
    decode.success(QueryRow(res:))
  }

  "select '{\"a\": 1}'::json as res"
  |> sql.query
  |> sql.format(sql.Tuple)
  |> sql.returning(decoder)
  |> sql.execute(db)
}


fn json_decoder() {
  use dynamic <- decode.then(decode.dynamic)
  decode.success(json_to_string(dynamic))
}

@external(javascript, "./sql_ffi.mjs", "jsonToString")
fn json_to_string(value: decode.Dynamic) -> String

