---
version: 1.5.1
title: timestamp encoding
file: ./test/squirrel_test.gleam
test_name: timestamp_encoding_test
---

import brioche/sql
import gleam/dynamic/decode
import gleam/javascript/promise
import gleam/time/timestamp.{type Timestamp}

pub type QueryRow {
  QueryRow(res: Bool)
}

pub fn query(
  db: sql.Connection,
  arg_1: Timestamp,
) -> promise.Promise(Result(sql.Returned(QueryRow), sql.SqlError)) {
  let decoder = {
    use res <- decode.field(0, decode.bool)
    decode.success(QueryRow(res:))
  }

  "select true as res where $1 = 'Jan-2-1970 12:34:56'::timestamp"
  |> sql.query
  |> sql.format(sql.Tuple)
  |> sql.parameter(sql.timestamp(arg_1))
  |> sql.returning(decoder)
  |> sql.execute(db)
}

