---
version: 1.5.1
title: bytea decoding
file: ./test/squirrel_test.gleam
test_name: bytea_decoding_test
---

import brioche/sql
import gleam/dynamic/decode
import gleam/javascript/promise

pub type QueryRow {
  QueryRow(res: BitArray)
}

pub fn query(
  db: sql.Connection,
) -> promise.Promise(Result(sql.Returned(QueryRow), sql.SqlError)) {
  let decoder = {
    use res <- decode.field(0, decode.bit_array)
    decode.success(QueryRow(res:))
  }

  "select 'aaa'::bytea as res"
  |> sql.query
  |> sql.format(sql.Tuple)
  |> sql.returning(decoder)
  |> sql.execute(db)
}

