---
version: 1.5.1
title: queries are sorted alphabetically
file: ./test/squirrel_test.gleam
test_name: queries_are_sorted_alphabetically_test
---

import brioche/sql
import gleam/dynamic/decode
import gleam/int
import gleam/javascript/promise

pub type FirstRow {
  FirstRow(wibble: Int)
}

pub fn first(
  db: sql.Connection,
) -> promise.Promise(Result(sql.Returned(FirstRow), sql.SqlError)) {
  let decoder = {
    use wibble <- decode.field(0, int_decoder())
    decode.success(FirstRow(wibble:))
  }

  "select 1 as wibble"
  |> sql.query
  |> sql.format(sql.Tuple)
  |> sql.returning(decoder)
  |> sql.execute(db)
}

pub type LastRow {
  LastRow(wibble: Int)
}

pub fn last(
  db: sql.Connection,
) -> promise.Promise(Result(sql.Returned(LastRow), sql.SqlError)) {
  let decoder = {
    use wibble <- decode.field(0, int_decoder())
    decode.success(LastRow(wibble:))
  }

  "select 1 as wibble"
  |> sql.query
  |> sql.format(sql.Tuple)
  |> sql.returning(decoder)
  |> sql.execute(db)
}


fn int_decoder() {
  decode.one_of(decode.int, or: [
    {
      use string <- decode.then(decode.string)
      case int.parse(string) {
        Ok(int) -> decode.success(int)
        Error(_) -> decode.failure(0, "Int")
      }
    },
  ])
}

