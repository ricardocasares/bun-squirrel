---
version: 1.5.1
title: float8 decoding
file: ./test/squirrel_test.gleam
test_name: float8_decoding_test
---

import brioche/sql
import gleam/dynamic/decode
import gleam/javascript/promise

pub type QueryRow {
  QueryRow(res: Float)
}

pub fn query(
  db: sql.Connection,
) -> promise.Promise(Result(sql.Returned(QueryRow), sql.SqlError)) {
  let decoder = {
    use res <- decode.field(0, decode.float)
    decode.success(QueryRow(res:))
  }

  "select 1.1::float8 as res"
  |> sql.query
  |> sql.format(sql.Tuple)
  |> sql.returning(decoder)
  |> sql.execute(db)
}

