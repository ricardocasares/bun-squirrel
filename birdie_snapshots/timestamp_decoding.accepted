---
version: 1.5.1
title: timestamp decoding
file: ./test/squirrel_test.gleam
test_name: timestamp_decoding_test
---

import brioche/sql
import gleam/dynamic/decode
import gleam/javascript/promise
import gleam/time/timestamp.{type Timestamp}

pub type QueryRow {
  QueryRow(res: Timestamp)
}

pub fn query(
  db: sql.Connection,
) -> promise.Promise(Result(sql.Returned(QueryRow), sql.SqlError)) {
  let decoder = {
    use res <- decode.field(0, sql.timestamp_decoder())
    decode.success(QueryRow(res:))
  }

  "select 'Jan-2-1970 12:34:56'::timestamp as res"
  |> sql.query
  |> sql.format(sql.Tuple)
  |> sql.returning(decoder)
  |> sql.execute(db)
}

